menu "breadboard: bb_openapi"

config BB_OPENAPI_RUNTIME_META
    bool "Ship OpenAPI runtime meta tables + engine into firmware"
    default n
    help
        Compiles the bb_serialize_meta engine (bb_serialize_meta_openapi_schema/
        bb_serialize_meta_validate) plus every co-located bb_serialize_desc_meta_t
        table across the tree (components/bb_serialize_meta) into the device
        image, for a runtime OpenAPI schema generator. Every describe-route
        component in the tree has adopted the descriptor-meta path -- none
        remain on hand-authored describe_route schemas -- and composes its
        schema from this engine at init when this knob is on. Default off
        ships zero bytes of this code; the PlatformIO native host test env
        always builds it regardless of this Kconfig. This is a
        runtime-compose opt-in, not a migration in progress: trading the
        device RAM/flash of the engine against generating schemas at init
        instead of shipping them as hand-authored describe_route literals.

endmenu
