# Build artifacts
build/
dist/
.pio/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old
sdkconfig.*
!sdkconfig.defaults
!sdkconfig.defaults.*
!sdkconfig/
!sdkconfig/profiles/
!sdkconfig/profiles/*.conf

# Tooling caches
.code-graph/
.breadboard/
compile_commands.json
gcovr-coveralls.json
gcovr-summary.json
gcovr-detail.json
*.o
*.d
*.bin
*.elf
*.map

# warning_fence_{host,firmware} live build-artifact reports (B1-1420 PR2) --
# scripts/warn_scan.sh writes these fresh every run (locally or in CI);
# only the shrink-only baseline JSONs under .baseline/ are committed.
/.baseline/bbtool/fence/warning_fence_reports/

# bbtool codegen output (decision #725 — generated code is a build
# artifact, never committed)
**/main/generated/

# Python
**/__pycache__/
*.pyc

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
